 group: www-data
 mode: "0750"

- name: Create.ssh directory for deploy
 ansible.builtin.file:
 path: "/home/{{ deploy_user }}/.ssh"
 state: directory
 owner: "{{ deploy_user }}"
 group: "{{ deploy_user }}"
 mode: "0700"

- name: Deploy authorized_keys with rrsync forced command
 ansible.builtin.template:
 src: templates/deploy_authorized_keys.j2
 dest: "/home/{{ deploy_user }}/.ssh/authorized_keys"
 owner: root
 group: root
 mode: "0644"
 # Root-owned so a stolen key can't change its own restrictions.
```

