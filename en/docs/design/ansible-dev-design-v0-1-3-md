## files/audit-listeners.sh

```sh
#!/bin/sh
# audit-listeners.sh — verify the interface contract.
# Fails if any non-loopback listener is not declared.
set -e

# Base: what bootstrap promises
ALLOWED="22/tcp"

# Layers register themselves
if [ -d /etc/uc-gradus/layers.d ]; then
 for f in /etc/uc-gradus/layers.d/*; do
 [ -f "$f" ] && ALLOWED="$ALLOWED $(cat "$f")"
 done
fi

# Get actual listeners (exclude loopback)
ACTUAL=$(ss -tlnpH 2>/dev/null \
 | grep -v "127\.0\.0\.1\|\[::1\]" \
 | awk '{print $4}' \
 | sed 's/.*://' \
 | sort -u)

FAIL=0
for port in $ACTUAL; do
 entry="${port}/tcp"
 if! echo "$ALLOWED" | grep -qw "$entry"; then
 echo "UNEXPECTED LISTENER: $entry" >&2
 FAIL=1
 fi
done

if [ "$FAIL" -eq 1 ]; then
 echo "Audit FAILED." >&2
 exit 1
fi

echo "Audit passed: listeners match interface contract."
```

## The gradus helper (updated for inventory-per-env)

```sh
case "$ACTION" in
 onboarding)
 OOB_USER="${1:-}"
 if [ -n "$OOB_USER" ]; then
 ansible-playbook -i "INV" "ANSIBLE/onboarding.yml" \
 -u "OOB_USER" -K --vault-password-file "VAULT_PASS" "${@:2}"
 else
 ansible-playbook -i "INV" "ANSIBLE/onboarding.yml" \
 -K --vault-password-file "VAULT_PASS" "{@}"
 fi
;;
 apply)
 LAYER="${1:?Need layer name}"
 ansible-playbook -i "INV" "ANSIBLE/${LAYER}.yml" \
 -K --vault-password-file "VAULT_PASS" "{@:2}"
;;
 check)
 ansible-playbook -i "INV" "ANSIBLE/onboarding.yml" \
 -K --check --diff --vault-password-file "VAULT_PASS" "{@}"
;;
 verify)
 HOSTS=(ansible -i "INV" web --list-hosts 2>/dev/null | tail -n +2)
 for host in $HOSTS; do
 IP=(ansible -i "INV" "$host" -m debug -a "var=ansible_host" \
 | grep ansible_host | awk '{print $NF}')
 "SCRIPT_DIR/test/incus/verify.sh" "IP"
 done
;;
 *)
 echo "Commands: onboarding, apply <layer>, check, verify"
 exit 1
;;
esac
```

## Usage examples

```sh
gradus onboarding dev root # first run as root
gradus onboarding dev # re-run as admin (drift check)
gradus apply dev caddy-server # the layer
gradus check dev # --check --diff
gradus verify dev # from outside
```

